---
import Logo from "./Logo.astro";
import { nav } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="site-header__inner container container--wide">
    <a href="/" class="site-header__brand" aria-label="EMI GARMENTS — home">
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["navlink", isActive(item.href) && "is-active"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/contact" class="btn btn--primary site-header__cta">Request a Quote</a>
      <button
        class="site-header__burger"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["mobile-menu__link", isActive(item.href) && "is-active"]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/contact" class="btn btn--primary mobile-menu__cta">Request a Quote</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    /* transparent over the dark hero */
    --logo-ink: var(--on-dark);
    --logo-accent: var(--camel-300);
    --nav-color: var(--on-dark);
    transition: background-color var(--dur-2) var(--ease-out),
                box-shadow var(--dur-2) var(--ease-out),
                border-color var(--dur-2) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background-color: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: var(--line);
    box-shadow: var(--shadow-sm);
    --logo-ink: var(--indigo-800);
    --logo-accent: var(--camel-500);
    --nav-color: var(--ink);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 6rem;
  }
  .site-header__brand { height: 4rem; display: inline-flex; align-items: center; }
  .site-header__brand .logo { height: 100%; }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .navlink {
    position: relative;
    color: var(--nav-color);
    font-weight: var(--wght-medium);
    font-size: 0.95rem;
    padding: 0.4rem 0;
    transition: color var(--dur-1) var(--ease-out);
  }
  .navlink::after {
    content: "";
    position: absolute;
    left: 0; bottom: -1px;
    width: 100%; height: 2px;
    background: var(--camel-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .navlink:hover::after, .navlink.is-active::after { transform: scaleX(1); }
  .navlink:hover { color: color-mix(in oklab, var(--nav-color) 70%, var(--camel-500)); }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-md); }
  .site-header__cta { min-height: 2.6rem; padding: 0.6rem 1.15rem; font-size: 0.9rem; }

  .site-header__burger {
    display: none;
    width: 44px; height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .site-header__burger span {
    width: 22px; height: 2px;
    background: var(--nav-color);
    transition: transform var(--dur-1) var(--ease-out), opacity var(--dur-1) var(--ease-out);
  }
  .site-header[data-open] .site-header__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .site-header[data-open] .site-header__burger span:nth-child(2) { opacity: 0; }
  .site-header[data-open] .site-header__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile drawer */
  .mobile-menu {
    position: fixed;
    inset: 6rem 0 0 0;
    background-color: var(--indigo-950);
    color: var(--on-dark);
    padding: var(--space-2xl) var(--gutter) var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .site-header[data-open] .mobile-menu { opacity: 1; transform: none; pointer-events: auto; }
  .mobile-menu ul { display: flex; flex-direction: column; gap: var(--space-xs); }
  .mobile-menu__link {
    display: block;
    font-family: var(--font-display);
    font-weight: 680;
    font-size: clamp(1.6rem, 8vw, 2.25rem);
    letter-spacing: var(--track-tight);
    color: var(--on-dark);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--on-dark-line);
  }
  .mobile-menu__link.is-active { color: var(--camel-300); }
  .mobile-menu__cta { align-self: flex-start; margin-top: var(--space-md); }

  @media (max-width: 56rem) {
    .site-header__nav, .site-header__cta { display: none; }
    .site-header__burger { display: inline-flex; }
    .site-header__inner { height: 5.25rem; }
    .site-header__brand { height: 3.5rem; }
    .mobile-menu { top: 5.25rem; }
  }
  @media (min-width: 56.0625rem) {
    .mobile-menu { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .navlink::after, .site-header__burger span { transition: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  // Solid header on scroll
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Mobile menu
  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true")
    );
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") setOpen(false);
    });
  }
</script>
