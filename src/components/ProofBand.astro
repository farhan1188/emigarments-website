---
import { proof } from "../data/site";
---
<section class="proof section--tight" data-theme="alt" aria-label="At a glance">
  <div class="container container--wide">
    <div class="proof__grid">
      <div class="proof__intro">
        <p class="proof__lead">
          A modern, vertically-integrated maker built to be checked, not just believed.
        </p>
      </div>
      <dl class="proof__stats">
        {proof.map((s) => (
          <div class="proof__stat">
            <dt class="proof__value">
              {s.value}
              {s.placeholder && <span class="proof__flag" title="Provisional — confirm before launch">✱</span>}
            </dt>
            <dd class="proof__label">{s.label}</dd>
            {s.note && <dd class="proof__note">{s.note}</dd>}
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .proof__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) 2fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  .proof__lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-h3);
    line-height: 1.25;
    letter-spacing: var(--track-tight);
    color: var(--text);
    margin-top: var(--space-md);
    max-width: 24ch;
  }
  .proof__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .proof__stat {
    padding-inline: var(--space-lg);
    border-left: 1px solid var(--hairline);
  }
  .proof__stat:first-child { padding-left: 0; border-left: 0; }
  .proof__value {
    font-family: var(--font-display);
    font-weight: var(--wght-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: var(--track-tight);
    color: var(--text);
  }
  .proof__flag { color: var(--accent-strong); font-size: 0.7em; vertical-align: super; margin-left: 0.15em; cursor: help; }
  .proof__label { font-weight: var(--wght-medium); margin-top: 0.4rem; }
  .proof__note { font-size: var(--step-small); color: var(--text-muted); margin-top: 0.2rem; }

  @media (max-width: 60rem) {
    .proof__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
  @media (max-width: 40rem) {
    .proof__stats { grid-template-columns: 1fr 1fr; gap: var(--space-lg) 0; }
    .proof__stat:nth-child(3) { padding-left: 0; border-left: 0; }
  }
</style>
