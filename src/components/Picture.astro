---
// Responsive Unsplash image. URLs are verified; Unsplash's CDN handles
// AVIF/WebP via `auto=format`. Container reserves space (aspect-ratio) → no CLS.
interface Props {
  img: string;
  alt: string;
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}
const {
  img,
  alt,
  ratio = "16 / 9",
  sizes = "100vw",
  widths = [480, 768, 1024, 1366, 1600, 2000],
  eager = false,
  fetchpriority,
  class: className,
} = Astro.props;

const base = `https://images.unsplash.com/${img}`;
const url = (w: number) => `${base}?auto=format&fit=crop&w=${w}&q=80`;
const srcset = widths.map((w) => `${url(w)} ${w}w`).join(", ");
---
<div class:list={["figure", className]} style={`--ratio:${ratio}`}>
  <img
    src={url(1366)}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "auto" : "async"}
    fetchpriority={fetchpriority}
  />
</div>

<style>
  .figure {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background-color: var(--indigo-900);
  }
  .figure img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
