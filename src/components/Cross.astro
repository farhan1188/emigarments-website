---
// The ✕ brand ornament (from the logo). Used sparingly as a divider / marker.
interface Props {
  size?: number;
  class?: string;
}
const { size = 14, class: className } = Astro.props;
---
<svg
  class:list={["cross", className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
>
  <path d="M3 3 L13 13 M13 3 L3 13" />
</svg>

<style>
  .cross { display: inline-block; flex: none; }
  .cross path {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
  }
</style>
