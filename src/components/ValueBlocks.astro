---
import { valueBlocks } from "../data/site";
interface Props {
  heading?: string;
  lead?: string;
}
const {
  heading = "We're a Progressive Industrial Group",
  lead = "EMIGARMENTS engineers textiles the way a precision manufacturer should: responsible practices, advanced systems, and consistent quality across four integrated divisions.",
} = Astro.props;
---
<section class="values section">
  <div class="container">
    <div class="values__head reveal">
      <h2 class="h2">{heading}</h2>
      <p class="lead values__lead">{lead}</p>
    </div>
    <div class="values__grid">
      {valueBlocks.map((b) => (
        <article class="values__item reveal">
          <h3 class="h3 values__title">{b.title}</h3>
          <p>{b.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .values__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md) var(--space-2xl);
    align-items: end;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .values__lead { max-width: 42ch; }
  .values__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }
  .values__item { padding-top: var(--space-lg); border-top: 2px solid var(--accent); }
  .values__title { margin-bottom: var(--space-sm); }
  .values__item p { color: var(--text-muted); max-width: 46ch; }

  @media (max-width: 52rem) {
    .values__head { grid-template-columns: 1fr; }
    .values__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>
