---
// A uniform certification seal (designed badge — not an official trademark).
// Swap for the real certification mark + number once confirmed.
---
<svg class="seal" viewBox="0 0 80 80" role="img" aria-hidden="true">
  <circle cx="40" cy="40" r="36" class="seal__ring-out" />
  <circle cx="40" cy="40" r="33" class="seal__ticks" />
  <circle cx="40" cy="40" r="28" class="seal__ring-in" />
  <path d="M30 40.5 l6.5 6.5 L50 33" class="seal__check" />
</svg>

<style>
  .seal { width: 3.25rem; height: 3.25rem; flex: none; }
  .seal__ring-out { fill: none; stroke: var(--accent); stroke-width: 1.4; }
  .seal__ring-in { fill: none; stroke: var(--accent); stroke-width: 0.8; opacity: 0.55; }
  .seal__ticks { fill: none; stroke: var(--accent); stroke-width: 4; stroke-dasharray: 0.5 6; opacity: 0.7; }
  .seal__check { fill: none; stroke: var(--accent); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
